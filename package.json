{
  "name": "meta-lead-ads-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Meta Lead Ads Real-Time Platform",
  "scripts": {
    "start": "concurrently -n \"SERVER,APP\" -c \"blue,green\" \"npm run start:server\" \"npm run start:app\"",
    "dev": "concurrently -n \"SERVER,APP\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:app\"",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "dev:app": "npm --prefix app start",
    "start:app": "npm --prefix app start",
    "web": "npm --prefix app run web",
    "dev:web": "concurrently -n \"SERVER,APP\" -c \"blue,green\" \"npm run dev:server\" \"npm run web\"",
    "build:web": "npm --prefix app run build:web",
    "build": "npm run build:web",
    "test": "npm --prefix server test && npm --prefix app test",
    "test:server": "npm --prefix server test",
    "test:app": "npm --prefix app test",
    "install:all": "npm --prefix server install && npm --prefix app install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
